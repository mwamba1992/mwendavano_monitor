# Monitor's own database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=mwendavano_monitor

# Secret: openssl rand -hex 32
JWT_SECRET=change-me

# Read-only connections to the monitored databases. Always the SELECT-only role.
RO_DB_USERNAME=monitor_ro
RO_DB_PASSWORD=
RO_DB_INVENTORY=monitor_dev_inventory
RO_DB_WAFANYAKAZI=monitor_dev_wafanyakazi
RO_DB_CARGO=monitor_dev_cargo

# The Soko App Review phone, left out of every number
REVIEW_PHONE=

# Off by default outside production
HEALTH_CHECKS_ENABLED=false
# Local only: pretend every check passes, so the panel looks live. Ignored in production.
HEALTH_SIMULATE=true
VISITOR_PARSER_ENABLED=false
NGINX_LOG_DIR=/var/log/nginx
# From deploy/update-geoip.sh. Without it, visits are still counted, just with no place.
GEOIP_DB=/var/lib/mwendavano-monitor/dbip-city-lite.mmdb
